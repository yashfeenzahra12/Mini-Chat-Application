<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Chat Application</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .chat-container {
            width: 100%;
            max-width: 450px;
            height: 650px;
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
            display: flex;
            flex-direction: column;
        }

        /* Header */

        .chat-header {
            background: #667eea;
            color: white;
            padding: 18px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .profile {
            width: 45px;
            height: 45px;
            background: white;
            color: #667eea;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 22px;
        }

        .user-info h2 {
            font-size: 18px;
        }

        .status {
            font-size: 12px;
            opacity: 0.9;
            margin-top: 3px;
        }

        .clear-btn {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border: none;
            padding: 8px 10px;
            border-radius: 7px;
            cursor: pointer;
        }

        .clear-btn:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        /* Messages */

        .chat-messages {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            background: #f5f6fa;
        }

        .message {
            max-width: 75%;
            padding: 11px 14px;
            margin-bottom: 12px;
            border-radius: 15px;
            word-wrap: break-word;
        }

        .message p {
            font-size: 15px;
        }

        .time {
            display: block;
            font-size: 10px;
            margin-top: 5px;
            opacity: 0.65;
        }

        .received {
            background: white;
            color: #333;
            border-bottom-left-radius: 3px;
            margin-right: auto;
        }

        .sent {
            background: #667eea;
            color: white;
            border-bottom-right-radius: 3px;
            margin-left: auto;
        }

        /* Input */

        .chat-input {
            padding: 15px;
            background: white;
            border-top: 1px solid #ddd;
            display: flex;
            gap: 10px;
        }

        .chat-input input {
            flex: 1;
            padding: 13px;
            border: 1px solid #ddd;
            border-radius: 25px;
            outline: none;
            font-size: 15px;
        }

        .chat-input input:focus {
            border-color: #667eea;
        }

        .send-btn {
            width: 48px;
            height: 48px;
            border: none;
            border-radius: 50%;
            background: #667eea;
            color: white;
            font-size: 18px;
            cursor: pointer;
        }

        .send-btn:hover {
            background: #5568d8;
        }

        @media (max-width: 500px) {
            body {
                padding: 0;
            }

            .chat-container {
                height: 100vh;
                border-radius: 0;
            }
        }
    </style>
</head>

<body>

    <div class="chat-container">

        <!-- Header -->

        <div class="chat-header">

            <div class="user-info">

                <div class="profile">
                    👤
                </div>

                <div>
                    <h2>Mini Chat</h2>
                    <div class="status">
                        ● Online
                    </div>
                </div>

            </div>

            <button
                class="clear-btn"
                onclick="clearChat()"
            >
                Clear
            </button>

        </div>


        <!-- Messages -->

        <div
            class="chat-messages"
            id="chatMessages"
        >

            <div class="message received">

                <p>
                    Hello! Welcome to Mini Chat 👋
                </p>

                <span class="time">
                    Just now
                </span>

            </div>

        </div>


        <!-- Input -->

        <div class="chat-input">

            <input
                type="text"
                id="messageInput"
                placeholder="Type a message..."
                autocomplete="off"
            >

            <button
                class="send-btn"
                onclick="sendMessage()"
            >
                ➤
            </button>

        </div>

    </div>


    <script>

        const messageInput =
            document.getElementById("messageInput");

        const chatMessages =
            document.getElementById("chatMessages");


        // Get current time

        function getTime() {

            const now = new Date();

            return now.toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit"
            });

        }


        // Send message

        function sendMessage() {

            const message =
                messageInput.value.trim();


            if (message === "") {
                return;
            }


            // Create sent message

            addMessage(
                message,
                "sent"
            );


            messageInput.value = "";


            // Automatic reply

            setTimeout(function() {

                const replies = [

                    "That's interesting! 😊",

                    "Thanks for your message!",

                    "Nice to hear from you! 👍",

                    "I understand.",

                    "Sounds great! 🎉",

                    "Thanks for chatting with me!"

                ];


                const randomReply =
                    replies[
                        Math.floor(
                            Math.random() *
                            replies.length
                        )
                    ];


                addMessage(
                    randomReply,
                    "received"
                );

            }, 800);

        }


        // Add message to chat

        function addMessage(
            text,
            type
        ) {

            const messageDiv =
                document.createElement("div");

            messageDiv.className =
                `message ${type}`;


            messageDiv.innerHTML = `

                <p>
                    ${escapeHTML(text)}
                </p>

                <span class="time">
                    ${getTime()}
                </span>

            `;


            chatMessages.appendChild(messageDiv);


            // Scroll to latest message

            chatMessages.scrollTop =
                chatMessages.scrollHeight;

        }


        // Prevent HTML injection

        function escapeHTML(text) {

            const div =
                document.createElement("div");

            div.textContent = text;

            return div.innerHTML;

        }


        // Enter key

        messageInput.addEventListener(
            "keydown",
            function(event) {

                if (event.key === "Enter") {

                    sendMessage();

                }

            }
        );


        // Clear chat

        function clearChat() {

            const confirmClear =
                confirm(
                    "Are you sure you want to clear the chat?"
                );


            if (confirmClear) {

                chatMessages.innerHTML = `

                    <div class="message received">

                        <p>
                            Chat cleared. Hello again! 👋
                        </p>

                        <span class="time">
                            ${getTime()}
                        </span>

                    </div>

                `;

            }

        }

    </script>

</body>
</html>
